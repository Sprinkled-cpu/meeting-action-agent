# =================================================================
# AI Meeting-to-Action Agent - Production Environment Configuration
# =================================================================

# Application Settings
APP_ENV=production
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# LLM Provider Configuration
# Options: mock | openai | gemini
DEFAULT_LLM_PROVIDER=mock

# OpenAI Integration (Optional)
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o

# Google Gemini Integration (Optional)
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_MODEL=gemini-2.0-flash

# Discourse Auditing & Alignment Controls
ENABLE_CONTRADICTION_AUDIT=true
ENABLE_OWNERSHIP_AUDIT=true
ENABLE_SCOPE_CREEP_AUDIT=true
STRICT_VALIDATION=true
